<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:p="http://www.springframework.org/schema/p"
        xmlns:context="http://www.springframework.org/schema/context"
        xmlns:mvc="http://www.springframework.org/schema/mvc"
        xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
                http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.0.xsd
                http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc-4.0.xsd">

	<!-- MVC 어노테이션 활성화 -->
	<mvc:annotation-driven />

	<!-- 컨트롤러 컴포넌트 스캔 -->
	<context:component-scan base-package="wini.winitest" use-default-filters="false">
        <context:include-filter type="annotation" expression="org.springframework.stereotype.Controller"/>
        <context:exclude-filter type="annotation" expression="org.springframework.stereotype.Service"/>
        <context:exclude-filter type="annotation" expression="org.springframework.stereotype.Repository"/>
    </context:component-scan>
    <context:component-scan base-package="egovframework.com" use-default-filters="false">
    	<context:include-filter type="annotation" expression="org.springframework.stereotype.Controller"/>
    	<context:exclude-filter type="annotation" expression="org.springframework.stereotype.Service"/>
        <context:exclude-filter type="annotation" expression="org.springframework.stereotype.Repository"/>
	</context:component-scan>

	<!-- ===== View Resolver 체인 (order 순서대로 시도) ===== -->

	<!-- 1순위: BeanName (jsonView 등 빈 이름으로 직접 반환하는 경우) -->
	<bean class="org.springframework.web.servlet.view.BeanNameViewResolver" p:order="0"/>

	<!-- Tiles 설정: tiles-def.xml 에 정의된 뷰는 Tiles, 없으면 자동으로 JSP 리졸버로 -->
	<bean id="tilesViewResolver" class="org.springframework.web.servlet.view.UrlBasedViewResolver">
    <property name="viewClass" value="org.springframework.web.servlet.view.tiles3.TilesView" />
    <property name="order" value="1" />
</bean>

	<!-- Tiles 설정 파일 위치 -->
	<bean id="tilesConfigurer"
	      class="org.springframework.web.servlet.view.tiles3.TilesConfigurer">
	    <property name="definitions">
	        <list>
	            <value>/WEB-INF/tiles/tiles-def.xml</value>
	        </list>
	    </property>
	</bean>

	<!-- 3순위: JSP 직접 매핑 (Tiles 정의가 없는 뷰) -->
	<bean class="org.springframework.web.servlet.view.UrlBasedViewResolver" p:order="2"
		  p:viewClass="org.springframework.web.servlet.view.JstlView"
		  p:prefix="/WEB-INF/views/" p:suffix=".jsp"/>

	<!-- JSON 응답용 빈 (return "jsonView" 시 사용) 현재 @Responsebody로 사용해서 안씀 -->
	<bean id="jsonView" class="org.springframework.web.servlet.view.json.MappingJackson2JsonView">
		<property name="contentType" value="text/html;charset=UTF-8"/>
	</bean>

	<!-- 파일 업로드 설정 -->
	<!--
	    CommonsMultipartResolver 크기 초과 시 동작 방식:
	    - maxUploadSizePerFile / maxUploadSize 초과 시 MaxUploadSizeExceededException 발생
	    - 예외 발생 후 클라이언트가 여전히 데이터를 전송 중이면 Tomcat 의 maxSwallowSize 설정에 따라
	      남은 요청 바디를 읽고 버린 뒤 응답을 전송한다.
	    - Tomcat 기본 maxSwallowSize = 2MB → 2MB 이상 남은 데이터가 있으면 연결 강제 종료
	      → 클라이언트에서 "연결이 끊겼습니다" 오류 발생
	    [근본 해결] Tomcat server.xml 의 <Connector> 에 maxSwallowSize="-1" 추가 필요 (아래 주석 참고)
	    [에러 페이지] SimpleMappingExceptionResolver 로 MaxUploadSizeExceededException 처리
	-->
	<bean id="multipartResolver"
	      class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
	    <property name="maxUploadSize"        value="52428800"/>  <!-- 50MB: 요청 전체 합산 제한 -->
	    <property name="maxInMemorySize"      value="1048576"/>   <!--  1MB: 디스크 저장 전 메모리 임시 버퍼 -->
	    <property name="maxUploadSizePerFile" value="10485760"/>  <!-- 10MB: 파일 1개당 제한 -->
	</bean>

	<!--
	    파일 크기 초과 예외 처리 (전자정부프레임워크 / Spring MVC 공통 방식)
	    MaxUploadSizeExceededException 발생 시 error/fileSizeError 뷰로 이동
	    - Tiles 정의 없음 → JSP ViewResolver 가 /WEB-INF/views/error/fileSizeError.jsp 로 해석
	    - order=1: Spring MVC 기본 ExceptionHandlerExceptionResolver(order=0) 다음 실행
	      MaxUploadSizeExceededException 은 @ExceptionHandler 처리 대상이 아니므로 이 resolver 가 처리
	-->
	<bean class="org.springframework.web.servlet.handler.SimpleMappingExceptionResolver">
	    <property name="exceptionMappings">
	        <props>
	            <prop key="MaxUploadSizeExceededException">error/fileSizeError</prop>
	        </props>
	    </property>
	    <property name="exceptionAttribute" value="ex"/>
	    <property name="order" value="1"/>
	</bean>

	<!-- 로그인 인터셉터: /user/*.do 를 제외한 모든 .do 요청에 적용 -->
	<mvc:interceptors>
    <mvc:interceptor>
        <mvc:mapping path="/**/*.do"/>
        <mvc:exclude-mapping path="/user/*.do"/>
        <bean class="wini.winitest.interceptor.LoginInterceptor"/>
    </mvc:interceptor>
	</mvc:interceptors>

</beans>
