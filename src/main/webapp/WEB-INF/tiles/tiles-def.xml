<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC
    "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN"
    "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">

<tiles-definitions>

    <!-- layout.simple  : 헤더 없음 - 첫 화면, 로그인, 회원가입 -->
    <definition name="layout.simple"  template="/WEB-INF/tiles/layout/simple.jsp"/>
    
    <!--  layout.main : 헤더/사이드바 포함 - 로그인 후 모든 페이지 -->
    <definition name="layout.main" template="/WEB-INF/tiles/layout/mainLayout.jsp">
    	<put-attribute name="title"   value="winiTest"/>
    	<put-attribute name="header" value="/WEB-INF/tiles/layout/header.jsp"/>
	    <put-attribute name="sidebar" value="/WEB-INF/tiles/layout/sidebar.jsp"/>
	    <put-attribute name="content" value=""/>
    </definition>

    <!-- ===== 로그인 ===== -->
    <definition name="user/login"    extends="layout.simple">
        <put-attribute name="title"   value="로그인"/>
        <put-attribute name="content" value="/WEB-INF/views/user/login.jsp"/>
    </definition>

	<!-- ===== 회원가입 ===== -->
    <definition name="user/register" extends="layout.simple">
        <put-attribute name="title"   value="회원가입"/>
        <put-attribute name="content" value="/WEB-INF/views/user/register.jsp"/>
    </definition>

    <!-- 게시판 -->
	<definition name="board/*" extends="layout.main">
	    <put-attribute name="content" value="/WEB-INF/views/board/{1}.jsp"/>
	</definition>
	
	<!-- 사용자관리 -->
	<definition name="user/*" extends="layout.main">
		<put-attribute name="title"   value="사용자관리"/>
	    <put-attribute name="content" value="/WEB-INF/views/user/{1}.jsp"/>
	</definition>
	
	<!-- 이미지 게시판 -->
	<definition name="gallery/*" extends="layout.main">
	    <put-attribute name="content" value="/WEB-INF/views/gallery/{1}.jsp"/>
	</definition>

	<!-- 설문 -->
	<definition name="survey/*" extends="layout.main">
	    <put-attribute name="content" value="/WEB-INF/views/survey/{1}.jsp"/>
	</definition>
	
	<!-- 설문 -->
	<definition name="role/*" extends="layout.main">
	    <put-attribute name="content" value="/WEB-INF/views/role/{1}.jsp"/>
	</definition>
</tiles-definitions>
